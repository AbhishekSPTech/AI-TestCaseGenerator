# All settings for the Test Case Generator.
# Copy this file to .env (gitignored) and fill in the values below. Never commit real keys.

# =============================================================================================
# LLM
# =============================================================================================

# Which LLM generates the test cases. Override per run with: npm start -- --provider claude
#   auto         - Azure OpenAI if AZURE_OPENAI_ENDPOINT, _API_KEY and _DEPLOYMENT are all set, otherwise Claude
#   azure-openai - always Azure OpenAI
#   claude       - always Claude (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=auto

# --- Claude (only needed when the provider is Claude) ----------------------------------------

# Claude API key (starts with sk-ant-)
#   1. Sign in to the Claude Console: https://platform.claude.com
#   2. Settings > API keys > Create key, give it a name, then copy the key (it is shown only once).
ANTHROPIC_API_KEY=

# Claude model id
CLAUDE_MODEL=claude-sonnet-5

# --- Azure OpenAI (only needed when the provider is Azure OpenAI) ----------------------------

# Azure portal > Azure OpenAI resource > Resource Management > Keys and Endpoint > Endpoint
#   e.g. https://your-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API key
#   1. Sign in to https://portal.azure.com and open the Azure OpenAI resource from AZURE_OPENAI_ENDPOINT.
#   2. Resource Management > Keys and Endpoint > copy KEY 1 (KEY 2 also works).
#   No portal access? Ask the resource owner / your Azure admin for the key.
AZURE_OPENAI_API_KEY=

# Deployment NAME (not the model or resource name). Azure AI Foundry > Deployments, or
# Azure portal > resource > Model deployments. Needs a model with function calling, e.g. gpt-4o / gpt-4.1.
AZURE_OPENAI_DEPLOYMENT=

# Azure OpenAI REST API version
OPENAI_API_VERSION=2024-10-21

# =============================================================================================
# Azure DevOps — only needed for: npm start -- --azure <work item id>
# =============================================================================================

# From the work item URL: https://dev.azure.com/{org}/{project}/_workitems/edit/<id>
#   e.g. ADO_ORG=your-org, ADO_PROJECT=YourProject
ADO_ORG=
ADO_PROJECT=

# Personal Access Token (PAT)
#   1. Open https://dev.azure.com/<ADO_ORG>.
#   2. User settings (icon next to your avatar, top right) > Personal access tokens > + New Token.
#   3. Organization: the same org. Scopes: Custom defined > Work Items: Read. Pick an expiry date.
#   4. Create, then copy the token (it is shown only once). Create a new one when it expires.
ADO_PAT=

# =============================================================================================
# Exported CSV
# =============================================================================================

# Area Path for manual stories (--file / typed in); stories read with --azure use the work item's own Area Path.
#   e.g. YourProject\YourTeam
ADO_AREA_PATH=

# "Assigned To" for every generated test case, as Azure DevOps shows it: Display Name <email>
#   Find yours in Azure DevOps: click your avatar (top right) — use the name and email shown there.
#   e.g. Jane Doe <jane.doe@example.com>   (leave empty to import the test cases unassigned)
ADO_ASSIGNED_TO=
