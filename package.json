{
  "name": "testcase-agent",
  "version": "1.0.0",
  "description": "CLI agent that turns user stories (Azure DevOps or manual input) into positive, negative and edge test cases with Claude or Azure OpenAI, and exports Azure Test Plans CSV",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbhishekSPTech/TestCaseGenerator.git"
  },
  "keywords": ["test-cases", "test-generation", "azure-devops", "azure-test-plans", "claude", "azure-openai", "llm", "qa"],
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "csv-stringify": "^6.5.0",
    "dotenv": "^16.4.0",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
